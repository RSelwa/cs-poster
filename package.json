{
  "name": "cs2-posters",
  "version": "2.0.0",
  "private": true,
  "type": "module",
  "description": "Affiches génératives de matchs CS2 à partir des données bo3.gg",
  "scripts": {
    "dev": "concurrently -k -n server,web -c blue,green \"node --watch-path=server --watch-path=src/core server/index.ts\" \"vite\"",
    "build": "tsc -b && vite build",
    "start": "NODE_ENV=production node server/index.ts",
    "typecheck": "tsc -b",
    "lint": "oxlint",
    "fixtures": "node fixtures/generate.mjs"
  },
  "dependencies": {
    "@hono/node-server": "^2.1.3",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.4.0",
    "hono": "^4.13.11",
    "lucide-react": "^1.48.0",
    "playwright": "^1.63.0",
    "radix-ui": "^1.6.7",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "shadcn": "^4.21.0",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^26.6.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "concurrently": "^10.0.5",
    "oxlint": "^1.86.0",
    "tailwindcss": "^4.3.3",
    "typescript": "~6.0.3",
    "vite": "^8.3.1"
  }
}
